# Normalize line endings across all platforms.
# The repository stores text files with LF (the index is already all-LF), and we
# check them out as LF everywhere. This keeps Windows working trees consistent
# with tools that write LF (e.g. scripts/bump-version.mjs, Prettier) and stops
# spurious "modified" churn on files like apps/src-tauri/Cargo.toml.
* text=auto eol=lf

# Explicit binary types (never normalize).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.exe binary
*.dll binary
*.zip binary

# Keep Windows batch files as CRLF (cmd.exe is picky about line endings).
*.bat text eol=crlf
*.cmd text eol=crlf
